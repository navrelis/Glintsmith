{
	"schemaVersion": 1,
	"id": "glintsmith",
	"version": "${version}",
	"name": "Glintsmith",
	"description": "Customize enchantment glints and item outlines for every item from every mod, and fix the gaps in item models.",
	"authors": [
		"navrelis"
	],
	"contact": {
		"homepage": "https://github.com/navrelis/Glintsmith",
		"sources": "https://github.com/navrelis/Glintsmith",
		"issues": "https://github.com/navrelis/Glintsmith/issues"
	},
	"license": "MIT",
	"icon": "assets/glintsmith/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"navrelis.glintsmith.Glintsmith"
		],
		"modmenu": [
			"navrelis.glintsmith.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"glintsmith.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"sodium": "*",
		"iris": "*"
	}
}
